<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SITEC PC Assembly &amp; QC" Height="820" Width="1180" WindowStartupLocation="CenterScreen" Background="#F3F6F8">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#263746" CornerRadius="8" Padding="18" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel><TextBlock Text="SITEC PC Assembly &amp; QC" FontSize="26" FontWeight="Bold" Foreground="White"/><TextBlock Text="Automatic Inventory | Optional Profile Comparison | Benchmark | WHEA | Evidence Certificate" Foreground="#D5E0E8"/></StackPanel>
        <TextBlock x:Name="TxtHeaderStatus" Text="PREPARING" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#A8E6BE"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel>
        <GroupBox Header="Unit identity" Margin="0,0,0,10" Padding="10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Asset ID" Grid.Row="0" Margin="0,7"/><TextBox x:Name="TxtAssetId" Grid.Row="0" Grid.Column="1" Height="30" Margin="4" ToolTip="Permanent identity of the complete PC. Tamper seal #1 follows this value automatically unless you overwrite the seal field."/>
            <TextBlock Text="QC recipe" Grid.Row="1" Margin="0,7"/><TextBlock x:Name="TxtProfileDisplay" Grid.Row="1" Grid.Column="1" Margin="6,8" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <CheckBox x:Name="ChkProfileComparison" Grid.Row="2" Grid.ColumnSpan="2" Content="Compare detected hardware with this profile (optional)" IsChecked="False" Margin="4,8,4,2" FontWeight="SemiBold" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Physical identity - scan only" Margin="0,0,0,10" Padding="10">
          <StackPanel>
            <TextBlock Text="Scan only the identifiers Windows cannot read. Tamper seal #1 is filled from Asset ID automatically; edit it only when the physical seal number is different." Foreground="#667" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="PSU serial" Grid.Row="0" Margin="0,7"/><TextBox x:Name="TxtPsuSerial" Grid.Row="0" Grid.Column="1" Height="30" Margin="4"/>
              <TextBlock Text="CPU 2D / ATPO" Grid.Row="1" Margin="0,7"/><TextBox x:Name="TxtCpuAtpo" Grid.Row="1" Grid.Column="1" Height="30" Margin="4" ToolTip="Scan the Intel top/edge 2D Data Matrix. For 12th Gen and later desktop CPUs this decodes the full unique ATPO serial."/>
              <TextBlock Text="Tamper seal #1" Grid.Row="2" Margin="0,7"/><TextBox x:Name="TxtSeal1" Grid.Row="2" Grid.Column="1" Height="30" Margin="4" ToolTip="Defaults to Asset ID. You can freely replace it with the actual physical tamper-seal serial when needed."/>
            </Grid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Benchmark selection" Margin="0,0,0,10" Padding="10">
          <StackPanel>
            <TextBlock Text="Select the hardware components to benchmark. Inventory, hardware identity/integrity checks, WHEA monitoring and evidence generation always remain enabled. Profile comparison is controlled separately above." Foreground="#667" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <UniformGrid Columns="2">
              <CheckBox x:Name="ChkBenchCpu" Content="CPU" IsChecked="True" Margin="4" ToolTip="WinSAT CPU qualification and CPU burn-in"/>
              <CheckBox x:Name="ChkBenchMemory" Content="RAM / Memory" IsChecked="True" Margin="4" ToolTip="WinSAT memory bandwidth and deterministic RAM verification"/>
              <CheckBox x:Name="ChkBenchDisk" Content="Storage / NVMe" IsChecked="True" Margin="4" ToolTip="DiskSpd qualification and sustained storage burn-in"/>
              <CheckBox x:Name="ChkBenchGraphics" Content="Graphics / GPU" IsChecked="True" Margin="4" ToolTip="Graphics workload during burn-in"/>
            </UniformGrid>
          </StackPanel>
        </GroupBox>

        <Button x:Name="BtnDetect" Content="Refresh Hardware" Height="38" Margin="0,0,0,8"/>
        <Button x:Name="BtnRun" Content="RUN SELECTED QC + FINALIZE" Height="52" FontWeight="Bold" FontSize="15" Background="#137C3D" Foreground="White"/>
        <Button x:Name="BtnCancel" Content="CANCEL BENCHMARK" Height="42" Margin="0,8,0,0" FontWeight="Bold" Background="#B42318" Foreground="White" IsEnabled="False" Visibility="Collapsed" ToolTip="Stops the active benchmark safely and preserves partial QC evidence and Full JSON."/>
      </StackPanel></ScrollViewer>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <GroupBox Header="Detected hardware" Grid.Row="0" Padding="10" Margin="0,0,0,10"><TextBox x:Name="TxtHardware" Height="190" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></GroupBox>
        <GroupBox Header="QC progress" Grid.Row="1" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="TxtStage" Text="Preparing" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#137C3D" Margin="12,0,0,0"/>
            </Grid>
            <ProgressBar x:Name="ProgressQc" Grid.Row="1" Height="24" Minimum="0" Maximum="100" Value="0" Margin="0,8"/>
            <Grid Grid.Row="2" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="TxtElapsed" Text="Elapsed: 00:00" Foreground="#445"/>
              <TextBlock x:Name="TxtRemaining" Grid.Column="1" Text="Remaining: --:--" Foreground="#445" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock x:Name="TxtMessage" Grid.Row="3" TextWrapping="Wrap" Foreground="#445"/>
          </Grid>
        </GroupBox>
        <TextBlock Grid.Row="2" Text="Worker log" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtLog" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
      </Grid>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="TxtFooter" Text="Workflow: confirm Asset ID, scan PSU serial and CPU ATPO, adjust tamper seal #1 only if needed, then run QC." Foreground="#667"/><Button x:Name="BtnOpenLast" Content="Open last report" DockPanel.Dock="Right" Width="140" Height="30" IsEnabled="False"/></DockPanel>
  </Grid>
</Window>
